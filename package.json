{
  "name": "ai-lawyer-kz",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin",
    "services/api"
  ],
  "scripts": {
    "bootstrap": "npm install && npm --prefix services/ai run setup --if-present && /Volumes/PD1000/job/flutter/bin/flutter pub get --directory apps/mobile",
    "format": "dart format apps/mobile/lib apps/mobile/test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:security": "node scripts/security-scan.mjs",
    "test:contract": "node scripts/contracts/check-openapi.mjs",
    "test:migrations": "node scripts/db/check-migrations.mjs",
    "test:design-source": "node scripts/design/check-design-source.mjs",
    "test:design-pixel": "python3 scripts/design/check-pixel-audit.py",
    "test:admin-ui": "node scripts/admin/check-ui-contract.mjs",
    "test:web-ui": "node scripts/web/check-ui-contract.mjs",
    "test:web-visual": "node scripts/web/check-visual-contract.mjs",
    "test:web-public-smoke": "node scripts/web/check-public-flow-smoke.mjs",
    "test:web-screenshots": "node scripts/web/check-screenshots.mjs",
    "test:web-screenshots:strict": "WEB_SCREENSHOT_STRICT=1 node scripts/web/check-screenshots.mjs",
    "test:web-pixel-diff": "python3 scripts/web/check-pixel-diff.py",
    "test:audit": "npm audit --audit-level=moderate",
    "test:ai": "PYTHONPATH=services/ai/app python3 -m unittest discover -s services/ai/app -p \"*test*.py\"",
    "generate:clients": "node scripts/contracts/generate-clients.mjs",
    "test:flutter": "cd apps/mobile && /Volumes/PD1000/job/flutter/bin/flutter test",
    "analyze:flutter": "/Volumes/PD1000/job/flutter/bin/flutter analyze apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:contract && npm run test:migrations && npm run test:design-source && npm run test:design-pixel && npm run test:web-pixel-diff && npm run test:admin-ui && npm run test:web-ui && npm run test:web-visual && npm run test:security && npm run test:audit && npm run analyze:flutter && npm run test:flutter && npm run test:ai",
    "docker:config": "docker compose -f infra/docker-compose.yml config",
    "release-check:local": "npm run check && npm run build && node scripts/release/check-rc-status.mjs",
    "release-check:production": "npm run release-check:local && npm run docker:config && node scripts/release/check-production-env.mjs",
    "release-check:production-env": "node scripts/release/check-production-env.mjs",
    "release-check:server": "node scripts/release/check-public-server.mjs",
    "release:bundle": "bash scripts/release/build-release-bundle.sh",
    "release-check": "npm run release-check:local",
    "deploy:package": "bash scripts/deploy/package-release.sh",
    "deploy:server-health": "bash scripts/deploy/server-health-check.sh",
    "deploy:firewall": "bash scripts/deploy/server-firewall.sh",
    "deploy:backup-postgres": "bash scripts/deploy/server-backup-postgres.sh",
    "deploy:install-backup-timer": "bash scripts/deploy/server-install-backup-timer.sh",
    "app-store:readiness": "node scripts/release/check-app-store-readiness.mjs",
    "app-store:review-plan": "node scripts/release/prepare-app-store-review-submission.mjs",
    "android:signing-check": "node scripts/release/check-android-signing.mjs",
    "release:blockers": "node scripts/release/check-release-blockers.mjs",
    "release:blockers:report": "node scripts/release/write-release-blockers-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "playwright": "^1.63.0",
    "typescript-eslint": "^8.69.0"
  }
}
